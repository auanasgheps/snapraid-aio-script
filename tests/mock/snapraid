#!/usr/bin/env bash
# Mock snapraid binary for tests.
# Controlled by MOCK_SCENARIO env var (defaults to status_synced).
# Ignores flags like -c <conf> and only acts on the subcommand.

SUBCOMMAND=""
SKIP_NEXT=0
for arg in "$@"; do
  if [ "$SKIP_NEXT" -eq 1 ]; then
    SKIP_NEXT=0
    continue
  fi
  case "$arg" in
    -c) SKIP_NEXT=1 ;; # skip -c flag and its argument
    -*) ;;             # skip other flags
    *) [ -z "$SUBCOMMAND" ] && SUBCOMMAND="$arg" ;;
  esac
done

if [ -n "${MOCK_SNAPRAID_LOG:-}" ] && [ "$MOCK_SNAPRAID_LOG" != "/snapraid_mock.log" ]; then
  echo "$*" >>"$MOCK_SNAPRAID_LOG"
fi

FIXTURES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../fixtures" && pwd)"
SCENARIO="${MOCK_SCENARIO:-status_synced}"

case "$SUBCOMMAND" in
  status)
    cat "$FIXTURES_DIR/${SCENARIO}.txt"
    exit 0
    ;;
  diff)
    cat "$FIXTURES_DIR/${SCENARIO}.txt"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
